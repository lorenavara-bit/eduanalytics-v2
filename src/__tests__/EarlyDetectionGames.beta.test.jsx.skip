import React from 'react';
import { render, screen, fireEvent, waitFor } from '@testing-library/react';
import '@testing-library/jest-dom';
import EarlyDetectionGames from '../components/EarlyDetectionGames';

// Mock supabase client used inside the component
jest.mock('../supabaseClient', () => ({
    supabase: {
        from: () => ({
            insert: jest.fn().mockResolvedValue({ error: null })
        })
    }
}));

// Mock the three game components to be simple placeholders that call onComplete
jest.mock('../components/games/PseudopalabrasGame', () => (props) => (
    <div data-testid="pseudopalabras-game">
        <button onClick={() => props.onComplete({ accuracy: 60 })}>Finish Dyslexia Game</button>
    </div>
));

jest.mock('../components/games/AtencionGame', () => (props) => (
    <div data-testid="atencion-game">
        <button onClick={() => props.onComplete({ commissions: 5, hits: 3 })}>Finish ADHD Game</button>
    </div>
));

jest.mock('../components/games/LogicaGame', () => (props) => (
    <div data-testid="logica-game">
        <button onClick={() => props.onComplete({ results: [{ isCorrect: true }, { isCorrect: false }, { isCorrect: true }, { isCorrect: true }] })}>Finish AACC Game</button>
    </div>
));

// Lista de beta‑testers (Jax y Skyler) – sus IDs pueden ser cualquier string
const betaTesters = ['jax', 'skyler'];

describe('EarlyDetectionGames integration test for beta testers', () => {
    const onBack = jest.fn();

    beforeAll(() => {
        // Mock window.alert to avoid real alerts during tests
        jest.spyOn(window, 'alert').mockImplementation(() => { });
    });

    afterAll(() => {
        jest.restoreAllMocks();
    });

    betaTesters.forEach((studentId) => {
        test(`beta tester ${studentId} can complete all games`, async () => {
            render(<EarlyDetectionGames studentId={studentId} onBack={onBack} />);

            // Verify the three cards are present
            expect(screen.getByText(/Laberinto de Palabras/i)).toBeInTheDocument();
            expect(screen.getByText(/Ojo de Águila/i)).toBeInTheDocument();
            expect(screen.getByText(/Detective de Patrones/i)).toBeInTheDocument();

            // ----- Dyslexia -----
            fireEvent.click(screen.getAllByRole('button', { name: /Jugar Ahora/i })[0]);
            await screen.findByTestId('pseudopalabras-game');
            fireEvent.click(screen.getByText(/Finish Dyslexia Game/i));
            await waitFor(() => expect(window.alert).toHaveBeenCalledWith('¡Resultado guardado correctamente! Misión cumplida.'));

            // ----- ADHD -----
            fireEvent.click(screen.getAllByRole('button', { name: /Jugar Ahora/i })[1]);
            await screen.findByTestId('atencion-game');
            fireEvent.click(screen.getByText(/Finish ADHD Game/i));
            await waitFor(() => expect(window.alert).toHaveBeenCalled());

            // ----- AACC -----
            fireEvent.click(screen.getAllByRole('button', { name: /Jugar Ahora/i })[2]);
            await screen.findByTestId('logica-game');
            fireEvent.click(screen.getByText(/Finish AACC Game/i));
            await waitFor(() => expect(window.alert).toHaveBeenCalled());

            // After each game we should be back to the card view
            expect(screen.getByText(/Laberinto de Palabras/i)).toBeInTheDocument();
        });
    });
});
